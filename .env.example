# Database Configuration
# 设置为 true 使用 SQLite（无需安装 PostgreSQL，推荐开发环境使用）
USE_SQLITE=true

# AI Provider Configuration
# 支持的提供商: openai, deepseek, custom
AI_PROVIDER=deepseek

# OpenAI API (如果使用 openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# DeepSeek API (如果使用 deepseek - 推荐国内用户)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Custom API (如果使用 custom - 兼容 OpenAI 格式的其他服务)
CUSTOM_API_KEY=your_custom_api_key_here
CUSTOM_BASE_URL=https://your-api-endpoint.com
CUSTOM_MODEL=your-model-name

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=novel2anime
DB_USER=postgres
DB_PASSWORD=your_password

# Server
PORT=3001
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
